{
    "dependencies": {
        "@stores.com/http-error": "~1.2.0",
        "@stores.com/ups": "~1.1.0",
        "@stores.com/usps": "~0.2.2",
        "@stores.com/xpo": "~0.2.2",
        "async": "~3.2.0",
        "dhl-ecommerce-solutions": "~0.5.0",
        "memory-cache": "~0.2.0",
        "moment-timezone": "~0.6.3",
        "pitney-bowes": "~1.0.0"
    },
    "description": "Bloodhound is a Node.js package that allows you to retrieve tracking data from shipping carriers (Amazon, DHL, FedEx, UPS, USPS) in a common format.",
    "devDependencies": {
        "@eslint/js": "*",
        "globals": "*"
    },
    "homepage": "https://github.com/stores-com/bloodhound",
    "keywords": [
        "amazon",
        "dhl",
        "fedex",
        "gofo",
        "logistics",
        "newgistics",
        "ontrac",
        "pitney-bowes",
        "shipping",
        "tracking",
        "ups",
        "usps",
        "xpo"
    ],
    "license": "MIT",
    "main": "index.js",
    "name": "@stores.com/bloodhound",
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/stores-com/bloodhound.git"
    },
    "scripts": {
        "coveralls": "node --test --test-force-exit --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=lcov.info && coveralls < lcov.info",
        "test": "node --test --test-force-exit --test-reporter=spec",
        "test:only": "node --test --test-force-exit --test-only --test-reporter=spec"
    },
    "version": "3.5.3"
}
